rules_version = '2';

// Every document lives under users/{uid}/... — a signed-in visitor can only
// ever read or write their own subtree. Nobody can read another person's
// journal, and a signed-out request is refused outright.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
